+const BANKS = 4;
+const TRACKS = 4;
+const STEPS = 16;
+
+const clamp = (v: number, min: number, max: number) => Math.max(min, Math.min(max, v));
+
+const deepClone = <T,>(obj: T): T => {
+  // structuredClone is fast + safe when available
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  const sc = (globalThis as any)?.structuredClone;
+  if (typeof sc === 'function') return sc(obj);
+  return JSON.parse(JSON.stringify(obj)) as T;
+};
+
+const safeLoadPatterns = (input: unknown): boolean[][][] => {
+  // Always returns [BANKS][TRACKS][STEPS]
+  const fallback = deepClone(DEMO_PATTERNS) as boolean[][][];
+  if (!Array.isArray(input)) return fallback;
+  const out: boolean[][][] = [];
+  for (let b = 0; b < BANKS; b++) {
+    const bank = Array.isArray((input as any)[b]) ? (input as any)[b] : [];
+    const outBank: boolean[][] = [];
+    for (let t = 0; t < TRACKS; t++) {
+      const track = Array.isArray(bank[t]) ? bank[t] : [];
+      const outTrack: boolean[] = [];
+      for (let s = 0; s < STEPS; s++) outTrack.push(!!track[s]);
+      outBank.push(outTrack);
+    }
+    out.push(outBank);
+  }
+  return out;
+};
+
+const ensurePatchDefaults = (p: DrumPatch | null): DrumPatch | null => {
+  if (!p) return null;
+  // Make sure filter exists so we never need patch.filter!
+  const filter = p.filter ?? { enabled: false, cutStart: 0, res: 0, sweep: 0, mode: 1 };
+  return { ...p, filter: { ...filter } };
