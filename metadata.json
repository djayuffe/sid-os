    "instrument-and-drum-synthesis",
    "midi-to-sid-voice-compilation",
    "midi-import-export",
    "midi-and-swm-export",
    "offline-audio-rendering",
    "mastering-and-mixer",
    "sid-register-diagnostics",
    "web-midi"
