    "channel": "stable",
    "tag": "v1.1.0",
    "platform": "web",
    "runtime": "browser"
  },
  "capabilities": [
    "sid-trace-playback",
    "psid-rsid-import",
    "c64-visualisation",
    "tracker-conversion",
    "tracker-sequence-editing",
